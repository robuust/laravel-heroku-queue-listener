{
    "name": "robuust/laravel-heroku-queue-listener",
    "description": "Laravel package to autoscale Heroku queue workers based on queue events",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-pcntl": "*",
        "illuminate/cache": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "php-heroku-client/php-heroku-client": "^4.0"
    },
    "require-dev": {
        "illuminate/config": "^10.0|^11.0|^12.0|^13.0",
        "laravel/pint": "^1.0",
        "phpunit/phpunit": "^11.5",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Robuust\\HerokuQueueListener\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Robuust\\HerokuQueueListener\\QueueAutoscalerServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "pint --test",
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
